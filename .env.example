# Optional Supabase backing for accounts and stat sync. Leave unset and the
# site runs fully local with every auth surface hidden.
#
# Copy to .env.local for local development (gitignored). On Render, set both
# as environment variables on each static site (they're baked in at build
# time; the anon key is designed to be public — row-level security is what
# protects the data).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# The origin this deployment answers on, used for the link-preview tags a
# scraper reads before it can run any JS. Defaults to production, so the dev
# site needs its own value — otherwise dev links advertise production's card,
# which 404s until the branch merges.
VITE_SITE_ORIGIN=https://dev.anagrimoire.com

# Optional Google Analytics (GA4). Leave unset and nothing loads. Use a
# separate measurement ID per environment (one GA4 property, one web data
# stream each for prod and dev) so the numbers stay separable.
VITE_GA_ID=G-XXXXXXXXXX
