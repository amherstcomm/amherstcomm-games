# Optional Supabase backing for accounts and stat sync. Leave unset and the
# site runs fully local with every auth surface hidden.
#
# Copy to .env.local for local development (gitignored). On Render, set both
# as environment variables on each static site (they're baked in at build
# time; the anon key is designed to be public — row-level security is what
# protects the data).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
