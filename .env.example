# Every value here is read at BUILD time, not run time. Vite compiles the
# VITE_* values into the bundle, so changing one means rebuilding:
#
#   docker compose up -d --build
#
# Copy this file to .env for Docker Compose (gitignored), or to .env.local for
# `npm run dev` (also gitignored, via the *.local rule).

# Supabase backing for accounts, stat sync and the daily feed. Leave both unset
# and the site runs fully local with every auth surface hidden — src/supabase.ts
# builds no client at all. The anon key is public by design; row-level security
# is what protects the data, so it is safe to have it compiled into the bundle.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# REQUIRED for any real deployment. The origin this instance answers on, used
# for the link-preview tags a scraper reads before it can run any JS, and for
# sitemap.xml and robots.txt.
#
# Set it, and set it to your own hostname. vite.config.ts falls back to
# https://anagrimoire.com when this is unset or empty, and treats that exact
# string as "this is production" — so a forgotten value ships robots.txt with
# `Allow: /`, advertises the upstream project's sitemap, and stamps the
# upstream domain into every preview tag. Any other value emits `Disallow: /`,
# which is what an internal, VPN-only deployment wants anyway.
#
# compose.yaml refuses to build without it. A bare `docker build` falls back to
# the Dockerfile's http://localhost:8080, which fails closed to Disallow.
VITE_SITE_ORIGIN=http://games.internal

# Optional Google Analytics (GA4). Leave unset and nothing loads — which is
# the right answer for an internal tool behind the VPN.
VITE_GA_ID=

# Host port the container publishes. Put TLS on a reverse proxy in front
# rather than inside the container.
WEB_PORT=8080
