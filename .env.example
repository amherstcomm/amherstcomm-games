# Every value here is read at BUILD time, not run time. Vite compiles the
# VITE_* values into the bundle, so changing one means rebuilding:
#
#   docker compose up -d --build
#
# Copy this file to .env for Docker Compose (gitignored), or to .env.local for
# `npm run dev` (also gitignored, via the *.local rule).

# Supabase backing for accounts, stat sync and the daily feed. Leave both unset
# and the site runs fully local with every auth surface hidden — src/supabase.ts
# builds no client at all. The anon key is public by design; row-level security
# is what protects the data, so it is safe to have it compiled into the bundle.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# REQUIRED for any real deployment. The origin this instance answers on, used
# for the link-preview tags a scraper reads before it can run any JS, and for
# sitemap.xml and robots.txt.
#
# Set it, and set it to your own hostname. vite.config.ts falls back to
# https://anagrimoire.com when this is unset or empty, and treats that exact
# string as "this is production" — so a forgotten value ships robots.txt with
# `Allow: /`, advertises the upstream project's sitemap, and stamps the
# upstream domain into every preview tag. Any other value emits `Disallow: /`,
# which is what an internal, VPN-only deployment wants anyway.
#
# compose.yaml refuses to build without it. A bare `docker build` falls back to
# the Dockerfile's http://localhost:8080, which fails closed to Disallow.
VITE_SITE_ORIGIN=http://games.internal

# What this deployment calls itself, in the masthead and the tab title.
# Defaults to "Amherst Games" — the same default vite.config.ts uses when it
# stamps index.html, held together by tests/unit/brand.test.ts.
VITE_SITE_NAME=Amherst Games

# The event this run of the site is for, shown under the name. Empty is the
# ordinary state and renders nothing at all, so blank it when the campaign
# ends rather than leaving last year's banner up.
#
#   VITE_SITE_SUBTITLE=Employee Ownership Month
#
# This becomes a database setting once the admin portal lands — an event
# subtitle should not need a rebuild. Until then it is a build value like the
# rest.
VITE_SITE_SUBTITLE=

# Single sign-on. Set one of the three below and the modal offers exactly one
# way in: the OAuth buttons and the magic-link form both come down, which is
# what makes "sign-in is through SSO" true rather than merely intended.
#
# Which route works is a property of your identity provider and the GoTrue
# build, not of this app — so it is configuration, and being wrong costs a
# rebuild rather than a code change.
#
#   VITE_SSO_PROVIDER          signInWithOAuth, for GoTrue's named OAuth
#                              providers ('github', 'google', 'keycloak', ...)
#   VITE_SSO_SAML_DOMAIN       signInWithSSO by email domain, for GoTrue's
#                              native SAML
#   VITE_SSO_SAML_PROVIDER_ID  signInWithSSO by the provider's UUID
#
# If more than one is set the order is provider id, then domain, then OAuth
# provider — fixed and covered by tests/unit/sso.test.ts, so a double
# configuration picks a route rather than silently reopening the email form.
#
# ZITADEL: use SAML, not VITE_SSO_PROVIDER=keycloak. GoTrue's Keycloak
# provider appends fixed Keycloak paths to its configured URL rather than
# doing OIDC discovery — /protocol/openid-connect/auth, /token, /userinfo —
# and Zitadel serves /oauth/v2/authorize, /oauth/v2/token and
# /oidc/v1/userinfo. The OAuth route only reaches Zitadel behind a proxy that
# rewrites those three paths.
#
# Leave all three unset and the site keeps the public-internet sign-in routes.
#
# The other half is on the server: disable GoTrue's email provider too, or the
# magic-link door is still open to anyone calling the API directly rather than
# using this page.
VITE_SSO_PROVIDER=
VITE_SSO_SAML_DOMAIN=
VITE_SSO_SAML_PROVIDER_ID=
# What the button calls it. People recognise their employer, not a protocol —
# "Continue with Amherst Communications", never a provider UUID.
VITE_SSO_LABEL=Amherst Communications

# Where a person writes when a form will not do. Shown in the privacy policy
# and the terms; leave it empty and those routes point at the in-app report
# form instead, which needs no mailbox and gives the reporter a reference.
#
# The one thing the form cannot do is answer a question about a specific
# account — only the address on the account can show whose account it is — so
# set this if you want that route to exist.
VITE_CONTACT_EMAIL=

 the container publishes. Put TLS on a reverse proxy in front
# rather than inside the container.
WEB_PORT=8080
