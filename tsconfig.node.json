{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  // The build-time TypeScript in scripts/ belongs here too. It imports from
  // src/, so without a project covering it a change to a solver signature
  // would break the harvest and nothing would say so until someone ran it.
  "include": ["vite.config.ts", "scripts/**/*.ts"]
}
