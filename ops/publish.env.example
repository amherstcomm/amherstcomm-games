# Copy to ops/publish.env (gitignored) and fill in.
#
# Server-side only. None of these may ever appear in the app's .env: anything
# prefixed VITE_ is compiled into the bundle and served to every browser, and
# the service-role key bypasses row-level security entirely.

# The Supabase gateway, as this VM sees it. Must be set — publish-puzzles.mjs
# defaults to the upstream project's hosted Supabase, so leaving it blank aims
# the publish at somebody else's database rather than failing.
SUPABASE_URL=http://localhost:8000

# service_role privilege. Either generation works — the legacy SERVICE_ROLE_KEY
# (an HS256 JWT, starts `eyJ`) or the current SUPABASE_SECRET_KEY (opaque,
# starts `sb_secret_`). PostgREST accepts both.
SUPABASE_SERVICE_ROLE_KEY=

# Mixed into every puzzle seed. **Set it once and never change it.**
#
# The generator is public and the date is its only other input, so without a
# salt every future board is computable by anyone with a clone. With it,
# determinism survives where it matters — a re-run reproduces the same day.
# Change it and every previously published date stops reproducing, which shows
# up as today's board differing from the one someone already played.
#
#   openssl rand -hex 32
PUZZLES_SEED_SALT=

# --- Auction emails (ops/send-auction-mail.sh) ------------------------------
#
# smtp or resend. Leave it empty and nothing is sent: the emails wait in the
# database until it is set.
MAIL_TRANSPORT=

# Who they come from. For Office 365 this must be the mailbox SMTP_USER signs
# in as, or one it has Send As rights on.
MAIL_FROM=

# Where the links in them point, with no trailing slash.
MAIL_SITE_URL=https://games.amherstcomm.net

# The clock closing times are written in. Defaults to America/Chicago.
MAIL_TIME_ZONE=

# Office 365: smtp.office365.com on 587, signed in as a licensed mailbox with
# SMTP AUTH turned on for it (Microsoft 365 admin centre > the user > Mail >
# Manage email apps > Authenticated SMTP). Security defaults switch SMTP AUTH
# off tenant-wide; that has to allow it too.
#
# Or an Office 365 relay connector, which knows this server by its public IP:
# SMTP_HOST is the tenant's MX host (<domain>-com.mail.protection.outlook.com),
# SMTP_PORT=25, and SMTP_USER and SMTP_PASS left empty.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Resend instead: MAIL_TRANSPORT=resend, an API key, and a MAIL_FROM on a
# domain verified with Resend.
RESEND_API_KEY=
